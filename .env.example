# 複製成 .env 再填入真實的值；.env 不會被 commit（密碼只放在 .env）
# 本機（Windows）執行用這裡的值；docker compose 裡的容器會把 DB_HOST、RABBITMQ_HOST 等換成容器名稱（見 docker-compose.yml）
# 標「選填」的不寫就用後面的預設值（common/config.py）

# ---------- PostgreSQL（docker compose 的 db）----------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_NAME=tw_stock

# ---------- Celery 任務佇列（docker compose 的 RabbitMQ）----------
# 1＝送進 RabbitMQ 給 Celery worker 做（celery-crawl-twse 等，要先 docker compose up）；
# 0＝在這台電腦依序執行，不需要 RabbitMQ（沒開 Docker 時臨時用）
USE_CELERY=1
RABBITMQ_HOST=127.0.0.1
# compose 把 RabbitMQ 的 5672 開在本機的 5673（管理介面 http://localhost:15673）
RABBITMQ_PORT=5673
# RabbitMQ 第一次啟動時用這組建帳號；之後要改密碼用 rabbitmqctl change_password（改這裡不會改到已經建好的帳號）
# 密碼別用 : / # 和空白（Flower 的連線網址沒辦法編碼，會被切錯）；@ 可以
RABBITMQ_USER=rabbitmq
RABBITMQ_PASSWORD=your-password-here

# ---------- docker compose 讀哪些設定檔 ----------
# 本機開發：基本設定＋docker-compose.local.yml（程式碼掛進容器、存檔自動重載）；docker compose 在 WSL 跑，所以用 : 隔開
# 放上雲端時改成 docker-compose.yml:docker-compose.prod.yml
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

# ---------- AI（ai/）：Claude API ----------
# 到 https://platform.claude.com 建 API key；沒設（或還是 your-… 範例值）就跳過 AI 任務，資料線、網站照常
ANTHROPIC_API_KEY=your-api-key-here
# AI_CLASSIFY_MODEL=claude-haiku-5-5   # 公告分類用的模型
# AI_SUMMARY_MODEL=claude-haiku-5-5    # 新聞摘要用的模型
# AI_CARD_MODEL=claude-haiku-5-5       # 卡片 AI 摘要用的模型
# EMBED_MODEL=BAAI/bge-m3              # 新聞 RAG：本機的 embedding 模型（第一次用時下載約 2.3 GB；換模型要改 schema/ai.sql 的向量維度）

# ---------- 新聞（FinMind）----------
# 到 https://finmindtrade.com 註冊拿 token，每小時的次數上限比較高；不填（或還是範例值）也抓得到
FINMIND_TOKEN=your-token-here
# NEWS_LOOKBACK_DAYS=7              # 被關注的股票往前抓幾天的新聞

# ---------- 網頁（dashboard/）呼叫的資料 API（FastAPI）----------
API_URL=http://127.0.0.1:8001
# SHOW_DATE_PICKER=1                # 顯示交易日選單（開發用；docker-compose.local.yml、run_web.bat 已經會設，上線的網站不要設）

# ---------- 選填：抓取的速度、重試 ----------
# SLEEP_SECONDS=1.0                 # 證交所：每個任務做完等幾秒（太快會被擋）
# SLEEP_SECONDS_MOPS=0.6            # 公開資訊觀測站：每個任務做完等幾秒
# SLEEP_SECONDS_FINMIND=6.0         # FinMind：每個任務做完等幾秒（帶 token 每小時 600 次，6 秒剛好；沒帶 token 上限更低，要調大）
# SLEEP_SECONDS_NEWS_DETAIL=0.5     # 新聞網頁：每個任務做完等幾秒
# MAX_RETRIES=3                     # 暫時性的失敗（逾時、HTTP 5xx、資料庫鎖）最多重試幾次
# RETRY_DELAY_SECONDS=5             # 重試前等幾秒
# PIPELINE_LOCK_WAIT_SECONDS=7200   # main.py 等上一輪跑完最多等幾秒（同一時間只跑一輪）

# ---------- 選填：紀錄 ----------
# JOB_LOG=1                         # 1＝每個任務跑完寫一列任務歷史 tw_stock.job_run；0＝不寫
# LOG_DIR=data/logs                 # worker 的文字 log 放哪（每天一個檔）
# LOG_KEEP_DAYS=30                  # 文字 log 留幾天

# ---------- 選填：備份（scripts/backup_db.py）----------
# BACKUP_DIR=data/backup            # 備份檔放哪
# PG_CONTAINER=postgres             # 沒裝 pg_dump 時，到這個容器裡跑 pg_dump
# PG_DUMP=C:\Program Files\PostgreSQL\17\bin\pg_dump.exe   # 本機有裝 pg_dump 就填路徑
