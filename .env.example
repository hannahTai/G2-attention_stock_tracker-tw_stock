# 複製成 .env 再填入真實的值；.env 不會被 commit
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_NAME=tw_stock

# Celery 任務佇列（docker compose 裡的 RabbitMQ）。0＝在這台電腦依序執行；1＝送進佇列給 worker 做
USE_CELERY=0
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5673
RABBITMQ_USER=worker
RABBITMQ_PASSWORD=your-password-here

# 網頁（Streamlit）呼叫的資料 API（FastAPI）
API_URL=http://127.0.0.1:8001
